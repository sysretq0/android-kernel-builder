# USB serial adapters over OTG (3D printers, consoles, embedded gear).
# Gate + the four common chips. Verified: zero `default m` in the whole
# usb-serial submenu (no ADVANCED-style straggler flood), gate needs only TTY.
# New names, no shipped .ko, so =y is insmod-hazard-free.
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_PL2303=y
