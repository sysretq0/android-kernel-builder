# CIFS/SMB network shares (NAS, VLC, file managers).
# Deps verified 5.10..6.18 (fs/cifs -> fs/smb/client move kept symbol names):
# CIFS needs INET; XATTR needs CIFS; POSIX needs CIFS + XATTR +
# CIFS_ALLOW_INSECURE_LEGACY (default y, no posture change).
# 6.12 note: CIFS selects NETFS_SUPPORT (new that tree), forcing it
# built-in while the module list demands netfs.ko -- handled by
# tools/drop-stale-module-outs.sh at build time (method: WildKernels),
# NOT by omitting the symbol here. Pre-6.12 trees have no NETFS_SUPPORT;
# 6.18 declares no netfs.ko. New names, no shipped cifs.ko
# (mount-on-demand, never boot-insmod'd).
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_KEYS=y
CONFIG_CIFS=y
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
