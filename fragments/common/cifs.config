# CIFS/SMB network shares (NAS, VLC, file managers).
# Deps verified 5.10..6.18 (fs/cifs -> fs/smb/client move kept symbol names):
# CIFS needs INET; XATTR needs CIFS; POSIX needs CIFS + XATTR +
# CIFS_ALLOW_INSECURE_LEGACY (default y, no posture change).
# NETFS_SUPPORT deliberately omitted: exists on none of our trees and
# nothing selects it (unknown =y would fail the check).
# New names, no shipped cifs.ko (mount-on-demand, never boot-insmod'd).
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_KEYS=y
CONFIG_CIFS=y
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
