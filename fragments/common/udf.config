# UDF optical/disc filesystem (DVDs, USB optical drives, some cameras).
# CIFS-shaped profile: dormant until mount, never boot-insmod'd.
# Deps verified 5.10..6.18: tristate, selects only core (BUFFER_HEAD /
# CRC_ITU_T / NLS / LEGACY_DIRECT_IO on newer trees); unset in every stock
# gki_defconfig; zero module-list entries on 6.12 (modules.bzl) and 6.18
# (modules_private.bzl), so built-in =y cannot trip Kleaf staging the way
# a stock-=m+declared symbol would.
CONFIG_UDF_FS=y
