# Metamodule (KernelSU module-manager, e.g. Mountify) support config
# Sources:
#   Mountify (github.com/backslashxx/mountify): CONFIG_OVERLAY_FS=y required,
#     CONFIG_TMPFS_XATTR=y highly encouraged
#   KernelSU metamodule guide: https://kernelsu.org/guide/metamodule.html
#
# Adapted from CloudFox-Kernel-Builder (build/fragments/cloudfox/
# metamodule-gki.config); version-specific notes generalized. Only symbols
# NOT already effective stock are listed here — OVERLAY_FS, FUSE_FS and
# TMPFS are =y on all trees (verified defconfigs) and were pruned.
# apply-fragments.sh skips symbols already effective in gki_defconfig or
# another fragment.

# Tmpfs extended attributes/ACLs used by systemless module mounting
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# Framework/userspace-driven config filesystems used by module tooling
CONFIG_SECURITYFS=y
CONFIG_CONFIGFS_FS=y

# CO-RE eBPF LKM support (e.g. Mountify's nuke_ext4_lkm). Generates vmlinux
# BTF, which requires pahole in the build toolchain. NOT enabled here; only
# uncomment if the toolchain for the branch being built ships pahole.
# CONFIG_DEBUG_INFO_BTF=y
