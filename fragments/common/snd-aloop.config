# ALSA loopback (snd-aloop) for audio-bridge projects (call routing to PC).
# In-tree PCM loopback, dormant until opened; =y because we ship Images,
# not .ko files (=m would need module delivery + signature trust).
# Safety verified 5.10..6.18: aloop.c present everywhere, identical
# tristate stanza (selects SND_PCM + SND_TIMER), SND=y stock, and zero
# aloop/pcm/timer .ko in any modules list (declared sound .kos are
# soc/hda/test only, unaffected by the selects).
# SND_DRIVERS gates all of sound/drivers/* (menuconfig, default n on GKI);
# without it SND_ALOOP is undeclared and Kleaf fails the per-symbol check.
# Zero `default m` under sound/drivers/ on 5.10..6.18, so unhiding the menu
# enables nothing else by itself.
CONFIG_SND_DRIVERS=y
CONFIG_SND_ALOOP=y
