# TCP BBR congestion control.
# BBR lives inside the `if TCP_CONG_ADVANCED` block (net/ipv4/Kconfig), which
# GKI leaves off -- without ADVANCED the symbol is undeclared and olddefconfig
# silently drops BBR, failing the per-symbol check. So both lines are needed.
# Makes BBR available (select at runtime via
# net.ipv4.tcp_congestion_control=bbr); the built-in default is unchanged.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
# ADVANCED unhides the whole CC block; BIC/WESTWOOD/HTCP default to =m on
# every tree, which Kleaf rejects as undeclared modules (and nobody needs
# eleven algorithms). CUBIC stays (default route), everything else stays n.
# `is not set` is vacuous-safe: trees lacking a symbol still pass the check.
# CONFIG_TCP_CONG_BIC is not set
# CONFIG_TCP_CONG_WESTWOOD is not set
# CONFIG_TCP_CONG_HTCP is not set
