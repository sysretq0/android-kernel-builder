# zswap compressed swap cache (+ zbud pool backend).
# ZSWAP needs CRYPTO=y (effective everywhere: CRYPTO_ZSTD=y is in every
# defconfig). Pre-6.6 trees also need FRONTSWAP (see per-branch
# frontswap.config -- symbol deleted upstream on 6.6+). Compressor default
# left stock; chosen at runtime (zstd available: CRYPTO_ZSTD=y everywhere).
CONFIG_ZSWAP=y
CONFIG_ZBUD=y
# No ZSMALLOC line on purpose: =m would build an undeclared .ko on every tree
# except 5.15 (Kleaf hard-fails "built but not copied"), and =y would hit the
# stale-insmod hazard. Stock per-tree behavior stands; zswap runs on zbud.
# No Z3FOLD either: 6.1+ gates it behind Z3FOLD_DEPRECATED (dead backend
# walking). zbud covers zswap everywhere.
