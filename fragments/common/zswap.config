# zswap compressed swap cache (+ all zpool backends).
# Deps verified across trees: ZSWAP needs FRONTSWAP (needs SWAP, default-y)
# and CRYPTO=y (effective everywhere: CRYPTO_ZSTD=y is in every defconfig).
# Z3FOLD needs ZPOOL, which ZSWAP selects. Compressor default left stock;
# chosen at runtime (zstd available: CRYPTO_ZSTD=y everywhere).
CONFIG_FRONTSWAP=y
CONFIG_ZSWAP=y
CONFIG_ZBUD=y
CONFIG_Z3FOLD=y
CONFIG_ZSMALLOC=y
