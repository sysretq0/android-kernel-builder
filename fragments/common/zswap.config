# zswap compressed swap cache (+ all zpool backends).
# Deps verified across trees: ZSWAP needs FRONTSWAP (needs SWAP, default-y)
# and CRYPTO=y (effective everywhere: CRYPTO_ZSTD=y is in every defconfig).
# Z3FOLD needs ZPOOL, which ZSWAP selects. Compressor default left stock;
# chosen at runtime (zstd available: CRYPTO_ZSTD=y everywhere).
CONFIG_FRONTSWAP=y
CONFIG_ZSWAP=y
CONFIG_ZBUD=y
CONFIG_Z3FOLD=y
# ZSMALLOC stays =m (stock GKI posture) on purpose: ramdisks insmod
# zsmalloc.ko unconditionally, and built-in would fail that with EBUSY/EEXIST
# (same hazard as zram.ko -- see CloudFox modskip rationale). zbud/z3fold ship
# no .ko, so =y is safe for them. zsmalloc pool available once loaded.
