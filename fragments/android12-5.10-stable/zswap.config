# zswap compressed swap cache (per-branch: KMI allowlist scoping).
# Proven green on this tree. android13-5.15 is excluded (its ABI list
# lacks the zpool exports); 6.18 dropped zpool upstream entirely.
# Pool backend rides alongside (zbud.config); this tree also needs
# frontswap.config (pre-6.6 prerequisite). Compressor default left
# stock; chosen at runtime (CRYPTO_ZSTD=y).
CONFIG_ZSWAP=y
