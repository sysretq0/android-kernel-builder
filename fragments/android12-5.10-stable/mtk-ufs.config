# MTK UFS storage built-in -- MTK-SoC DEVICES ONLY.
# Stock GKI ships SCSI_UFS_MEDIATEK as a vendor_boot module, which cannot
# load on a custom kernel (vermagic/CRC drift) -- without it UFS never
# probes, no partitions appear, init panics after the 10s wait
# ("partition(s) not found", then "Attempted to kill init").
# =y drags PHY_MTK_UFS + RESET_TI_SYSCON via select. DELETE THIS FILE if
# your device is not MediaTek: ARCH_MEDIATEK=n forces it off and the
# defconfig check fails the build.
CONFIG_SCSI_UFS_MEDIATEK=y
