# zswap compressed swap cache (+ zbud pool backend) -- 6.6 ONLY.
# Scoped per-branch, not common: ZSWAP selects ZPOOL, whose exports
# (zpool_register_driver/unregister_driver) are outside the KMI allowlist
# on 5.10/5.15/6.1 (strict ABI check hard-fails the build there).
# Proven green on 6.6 only; do NOT promote without a full green build.
# FRONTSWAP needs no line here (deleted upstream on 6.6+).
# Compressor default left stock; chosen at runtime (CRYPTO_ZSTD=y).
CONFIG_ZSWAP=y
CONFIG_ZBUD=y
