# USB serial adapters over OTG (3D printers, consoles, embedded gear).
# 5.10-only: stock neither builds nor declares these (pure add, =y safe).
# 5.15+: stock ships them as modules (declared in modules.bzl) -- flipping
# to =y there would orphan the declaration, so this stays off those trees
# (their story belongs to future module shipping, not fragments).
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_PL2303=y
