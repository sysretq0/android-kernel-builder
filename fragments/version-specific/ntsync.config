# NTSYNC Windows-NT sync primitive emulation (GameFusion/Wine/Proton).
# 6.18-only: symbol exists solely there (BROKEN-gated on 6.12, absent on
# 6.6 and older), so this lives per-branch, not in common/.
# Deps verified on 6.18: dep-less tristate, unset in stock gki_defconfig,
# zero entries in bazel/modules_private.bzl -- built-in =y is staging-safe.
# Dormant char device (/dev/ntsync) until opened; no boot path, no
# interaction with KSU/SuSFS/NoMount/guard.
CONFIG_NTSYNC=y
