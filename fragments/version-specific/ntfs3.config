# NTFS3 read/write (USB-OTG NTFS drives, mount -t ntfs3).
#
# Per-branch only: fs/ntfs3 does not exist on 5.10, so a common/ copy
# would fail check_defconfig there with an unknown symbol.
# Audit (5.15+): NTFS3_FS tristate, default n. Selects: NLS only on
# 5.15/6.1; + BUFFER_HEAD + LEGACY_DIRECT_IO on 6.6+ (all non-module
# symbols; NLS already forced =y by live CIFS on every tree).
# Kleaf module-outs re-verified at activation.
CONFIG_NTFS3_FS=y
